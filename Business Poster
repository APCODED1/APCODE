@charset "utf-8";

body { margin: 0px; font-family: Arial, sans-serif; display: flex; justify-content: center; padding: 20px; background: linear-gradient(gold, black); }

.poster { width: 450px; background: linear-gradient(135deg, black, gold); color: white; border-radius: 15px; padding: 20px; box-shadow: rgba(0, 0, 0, 0.14) 0px 10px 30px; }

.header { text-align: center; }

.logo { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid gold; }

.title { font-size: 22px; font-weight: bold; margin-top: 7px; letter-spacing: 1px; color: silver; }

.own { font-weight: bold; font-size: 30px; margin-top: 5px; background: linear-gradient(black, gold); color: white; }

.tagline { font-size: 13px; color: rgb(187, 187, 187); margin-bottom: 17px; }

.owner { display: flex; align-items: center; gap: 10px; background: rgba(255, 245, 205, 0.18); padding: 10px; border-radius: 10px; margin-bottom: 15px; }

.owner img { width: 95px; height: 95px; border-radius: 50%; object-fit: cover; border: 2px solid white; }

.owner p { margin: 0px; font-size: 1.5rem; color: gold; }

.section-title { color: gold; font-size: 20px; margin: 10px 0px; }

ul { padding-left: 0px; }

ul li { list-style: circle; padding: 5px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); font-size: 20px; margin-left: 20px; }

.gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 10px; }

.gallery img { width: 100%; height: 90px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); }

.contact { margin-top: 15px; background: rgba(255, 255, 255, 0.1); padding: 10px; border-radius: 10px; font-size: 13px; }

.footer { text-align: center; margin-top: 10px; font-size: 11px; color: black; }

.contact a { display: inline-block; padding: 6px 12px; margin-top: 5px; background: gold; color: black; border-radius: 5px; text-decoration: none; font-weight: bold; }

.contact a:hover { background: white; }
